<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0A1628"
                android:endColor="#0D2B3E"
                android:angle="135"/>
        </shape>
    </item>
    <!-- Center A logo -->
    <item
        android:gravity="center"
        android:width="64dp"
        android:height="64dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#D4A847"
                android:endColor="#F5D77A"
                android:angle="135"/>
        </shape>
    </item>
</layer-list>
